{
  "name": "@chainpay/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@chainpay/database": "workspace:^",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@chainpay/shared": "workspace:^",
    "@chainpay/blockchain": "workspace:^",
    "viem": "^2.37.0",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "@chainpay/worker": "workspace:^",
    "bullmq": "^5.58.0"
  }
}
