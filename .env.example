# Local development only. Shell exports configure API; Compose reads this file
# only when supplied through --env-file .env.example (or copied to .env).
NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1
POSTGRES_USER=chainpay
POSTGRES_PASSWORD=chainpay_local
POSTGRES_DB=chainpay
POSTGRES_PORT=5432
REDIS_PORT=6379
# API requires DATABASE_URL; worker requires DATABASE_URL and REDIS_URL.
DATABASE_URL=postgresql://chainpay:chainpay_local@127.0.0.1:5432/chainpay
REDIS_URL=redis://127.0.0.1:6379

# Exact allowed Origin for session login and cookie-authenticated writes.
MERCHANT_ORIGIN=https://localhost:3000
# Set privately before running db:seed; no built-in demo password.
DEMO_MERCHANT_PASSWORD=
DEMO_RECEIVER_ADDRESS=
# Optional locally; required for PostgreSQL integration test execution.
TEST_DATABASE_URL=postgresql://chainpay:chainpay_local@127.0.0.1:5432/chainpay

# Phase 2: testnet RPC is used only for server reads; never supply wallet secrets.
BASE_SEPOLIA_RPC_URL=
BERACHAIN_RPC_URL=
VERIFY_CONFIRMATIONS=3
TEST_REDIS_URL=redis://127.0.0.1:6379

# Public API origin used by browser requests. This is exposed in the web bundle.
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:3001
